# ============================================================
# 面试证据助手 - 环境变量配置模板
# 使用方式：复制此文件为 .env，填入实际值
# ============================================================

# --- 模型模式切换 ---
# "ollama"   = 本地 Ollama 推理（qwen:7b-q3_K_M）
# "deepseek" = DeepSeek 云端 API（OpenAI 兼容接口）
LLM_MODE=deepseek

# --- DeepSeek 云端配置（LLM_MODE=deepseek 时必填）---
# 在 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_MODEL=你的模型
DEEPSEEK_BASE_URL=你的API地址

# --- Ollama 本地配置（LLM_MODE=ollama 时生效）---
OLLAMA_MODEL=qwen:7b-q3_K_M
